# CloudPort Backend Configuration (Placeholders Only - Never commit real secrets)

# Your Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Firestore collection for storing event registrations
COLLECTION=registrations

# Allowed CORS origins for the frontend website (comma-separated).
# In production, specify your Cloud Storage static site URL or custom domain:
# e.g.: https://storage.googleapis.com,https://your-custom-domain.com
# For local testing, use: http://localhost:8080,http://127.0.0.1:8080 or *
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://storage.googleapis.com

# Pub/Sub topic name (optional decoupled async event trigger, e.g., for sending confirmation emails)
PUBSUB_TOPIC=registration-created

# Optional: Firestore Emulator host for offline local backend testing
# FIRESTORE_EMULATOR_HOST=localhost:8085
